[Unit]
Description=SoulCam Scene Hub — Detection Event Consumer
After=soulcam.service
Wants=soulcam.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/SoulCam

# Listen for detection events, serve HTTP API on port 8080
ExecStart=/usr/bin/python3 /home/ubuntu/SoulCam/scene/scene_hub.py --http 8080

Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scene_hub

[Install]
WantedBy=multi-user.target
