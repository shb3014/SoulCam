{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulcam.local/soullink/profile-descriptor.schema.json",
  "title": "Soullink Profile Descriptor",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "description",
    "profile"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "required": [
        "deviceType",
        "mdnsServiceTypes",
        "mqttTopicPrefix",
        "defaultPorts",
        "capabilities",
        "channelPolicy"
      ],
      "properties": {
        "deviceType": {
          "type": "string",
          "const": "soulcam"
        },
        "mdnsServiceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^_[a-zA-Z0-9-]+\\._tcp\\.local$"
          }
        },
        "mqttTopicPrefix": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+/$"
        },
        "defaultPorts": {
          "type": "object",
          "required": [
            "mqtt",
            "api",
            "streamTcp",
            "streamIndex"
          ],
          "properties": {
            "mqtt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "api": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "streamTcp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "streamIndex": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "required": [
            "dp",
            "message",
            "stream",
            "sync",
            "monitor",
            "videoStream",
            "directorMode"
          ],
          "properties": {
            "dp": {
              "type": "boolean"
            },
            "message": {
              "type": "boolean"
            },
            "stream": {
              "type": "boolean"
            },
            "sync": {
              "type": "boolean"
            },
            "monitor": {
              "type": "boolean"
            },
            "videoStream": {
              "type": "boolean"
            },
            "directorMode": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "channelPolicy": {
          "type": "object",
          "required": [
            "useCompositeDeviceKey"
          ],
          "properties": {
            "useCompositeDeviceKey": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
